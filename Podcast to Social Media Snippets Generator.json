{
  "name": "Podcast to Social Media Snippets Generator",
  "nodes": [
    {
      "parameters": {
        "triggerOn": "fileCreated",
        "folderId": "1aBcD2eFgH3iJkL4mNoP5qRsT"
      },
      "id": "1",
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "transcribe",
        "audioFile": "={{ $json.fileId }}"
      },
      "id": "2",
      "name": "OpenAI Whisper",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "prompt": "Create 3 engaging social media posts based on the following transcript. Each post should be distinct and have relevant emojis. Transcript: {{$json.text}}"
      },
      "id": "3",
      "name": "OpenAI GPT-4",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "text": "={{ $json.post1 }}"
      },
      "id": "4",
      "name": "Buffer",
      "type": "n8n-nodes-base.buffer",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Google Drive Trigger": {
      "main": [
        [
          {
            "node": "OpenAI Whisper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Whisper": {
      "main": [
        [
          {
            "node": "OpenAI GPT-4",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI GPT-4": {
      "main": [
        [
          {
            "node": "Buffer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "={{ $env.GLOBAL_ERROR_HANDLER_ID }}"
  }
}
